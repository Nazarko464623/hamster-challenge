import { useRouter } from 'expo-router';
import { StatusBar } from 'expo-status-bar';
import { useState } from 'react';
import { Pressable, ScrollView, StyleSheet, Text, TextInput, View } from 'react-native';
import { useSafeAreaInsets } from 'react-native-safe-area-context';

export default function CreateScreen() {
  const router = useRouter();
  const insets = useSafeAreaInsets();
  const [title, setTitle] = useState('');
  const [description, setDescription] = useState('');

  return (
    <View style={styles.screen}>
      <StatusBar hidden />
      <ScrollView
        contentContainerStyle={[styles.content, { paddingTop: Math.max(insets.top, 24) }]}
        keyboardShouldPersistTaps="handled">
        <View style={styles.header}>
          <Pressable
            accessibilityLabel="Back to home"
            accessibilityRole="button"
            onPress={() => router.back()}
            style={styles.backButton}>
            <Text style={styles.backIcon}>‹</Text>
          </Pressable>
          <Text style={styles.headerTitle}>Create</Text>
          <View style={styles.headerSpacer} />
        </View>

        <View style={styles.intro}>
          <Text style={styles.title}>Start a challenge</Text>
          <Text style={styles.subtitle}>Invite others to compete and have fun.</Text>
        </View>

        <View style={styles.form}>
          <Text style={styles.label}>Challenge name</Text>
          <TextInput
            accessibilityLabel="Challenge name"
            onChangeText={setTitle}
            placeholder="Enter a name"
            placeholderTextColor="#B9A58E"
            style={styles.input}
            value={title}
          />

          <Text style={styles.label}>Description</Text>
          <TextInput
            accessibilityLabel="Challenge description"
            multiline
            onChangeText={setDescription}
            placeholder="What is the challenge about?"
            placeholderTextColor="#B9A58E"
            style={[styles.input, styles.descriptionInput]}
            value={description}
          />
        </View>

        <Pressable
          accessibilityRole="button"
          accessibilityLabel="Create challenge"
          disabled={!title.trim()}
          style={({ pressed }) => [styles.createButton, !title.trim() && styles.disabledButton, pressed && styles.pressed]}
          onPress={() => router.back()}>
          <Text style={styles.createButtonText}>Create challenge</Text>
        </Pressable>
      </ScrollView>
    </View>
  );
}

